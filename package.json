{
  "name": "basketcase-serverless",
  "version": "0.0.21",
  "description": "Serverless function that provides product and facet data to a mock online store app selling washing machines",
  "main": "index.js",
  "scripts": {
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run --reporter verbose",
    "info": "SLS_AWS_SDK=3 serverless info",
    "deploy": "SLS_AWS_SDK=3 serverless deploy",
    "logs": "SLS_AWS_SDK=3 serverless logs -f search",
    "invoke": "SLS_AWS_SDK=3 serverless invoke -f search",
    "invoke:jq": "SLS_AWS_SDK=3 serverless invoke -f search | jq '.body | fromjson'",
    "invoke:local": "SLS_AWS_SDK=3 serverless invoke local -f search"
  },
  "author": "Jonathan Taylor",
  "license": "MIT",
  "dependencies": {
    "@elastic/elasticsearch": "7.13.0",
    "axios": "^1.18.1",
    "serverless": "^4.40.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/eslint-plugin": "^1.6.24",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "vitest": "^4.1.9"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "serverless@4.40.0": true
  }
}
